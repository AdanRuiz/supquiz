<mxfile host="app.diagrams.net"><diagram id="supquiz-architecture" name="Architecture"><mxGraphModel dx="1320" dy="790" grid="1" gridSize="10" guides="1" page="1" pageWidth="1320" pageHeight="790"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="vercel" value="Vercel · supquiz.vercel.app" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#334155;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="300" y="60" width="340" height="640" as="geometry"/></mxCell><mxCell id="supabase" value="Supabase" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#16a34a;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=14;fontStyle=1;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="720" y="60" width="360" height="640" as="geometry"/></mxCell><mxCell id="host" value='&lt;b&gt;Host (teacher)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Browser on laptop&lt;br&gt;+ projector&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#15803d;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="200" height="90" as="geometry"/></mxCell><mxCell id="players" value='&lt;b&gt;Players&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;Phone browsers&lt;br&gt;scan the QR code&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#15803d;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="200" height="90" as="geometry"/></mxCell><mxCell id="github" value='&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;AdanRuiz/supquiz&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="200" height="80" as="geometry"/></mxCell><mxCell id="hostpages" value='&lt;b&gt;Host pages&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;/host/login · /host/dashboard&lt;br&gt;/host/game/[id] (big screen)&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="330" y="110" width="280" height="90" as="geometry"/></mxCell><mxCell id="playerpages" value='&lt;b&gt;Player pages&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;/game/[id]&lt;br&gt;join · answer · result&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="330" y="330" width="280" height="90" as="geometry"/></mxCell><mxCell id="api" value='&lt;b&gt;API route (Node function)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;POST /api/auth/request-link&lt;br&gt;service role key, server only&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="330" y="520" width="280" height="100" as="geometry"/></mxCell><mxCell id="postgres" value='&lt;b&gt;Postgres + row-level security&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;quiz_sets · questions · choices&lt;br&gt;games · participants · answers&lt;br&gt;save_quiz_set() validates quizzes&lt;br&gt;guard_staff_accounts() trigger:&lt;br&gt;only @tec.mx host accounts&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="750" y="110" width="300" height="180" as="geometry"/></mxCell><mxCell id="realtime" value='&lt;b&gt;Realtime&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:11px"&gt;postgres_changes on games,&lt;br&gt;participants and answers&lt;/font&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ff