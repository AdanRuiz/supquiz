# Copy this file to .env.local and fill in the values.
# Never commit .env.local: it holds secrets.

# Supabase (from `supabase status` locally, or Project Settings → API in the cloud)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used to create host accounts. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Brevo transactional email (account links). Optional in local development:
# without them, the link is printed in the `npm run dev` terminal instead.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Public URL used in account emails. Defaults to the request origin locally.
SITE_URL=http://localhost:3000
